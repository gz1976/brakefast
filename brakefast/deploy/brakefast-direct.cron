# BrakeFast direct host cron. Install as /etc/cron.d/brakefast-direct.
# Seit 2026-09-02 läuft die Pipeline im eigenen Container brakefast-pipeline
# (/docker/brakefast-pipeline), nicht mehr im OpenClaw-Container.
SHELL=/bin/bash
PATH=/usr/bin:/bin:/usr/sbin:/sbin
30 5 * * * root docker exec -e BRAKEFAST_HOST_CONTAINER_COUNT="$(docker ps -q | wc -l | tr -d ' ')" brakefast-pipeline /data/.openclaw/workspace/brakefast/scripts/brakefast-daily.sh >> /var/log/brakefast-host-cron.log 2>&1
