# Copy to brakefast/config/briefing.env or briefing.local.env
# and replace with real values. Without these variables the
# briefing engine falls back to heuristic summaries.
# Optional: define a full OpenClaw-style provider chain as JSON.
# Example:
# BRAKEFAST_LLM_PROVIDER_CHAIN='[
#   {"name":"primary","base_url":"https://openrouter.ai/api/v1","api_key_env":"OPENROUTER_API_KEY","model":"openrouter/anthropic/claude-sonnet-4-6"},
#   {"name":"fallback-openai","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY","model":"gpt-5-mini"}
# ]'
# Optional: eigene Kette nur fuer die Kurations-Spec (Step 2a), gleiches Format.
# Ohne diese Variable nutzt die Spec die Text-Kette. Sinnvoll, wenn der erste
# Text-Provider fuer die grosse Spec-Anfrage regelmaessig ins Zeitfenster laeuft,
# beim Enrichment aber gut arbeitet.
# BRAKEFAST_SPEC_PROVIDER_CHAIN='[
#   {"name":"flash","provider_ref":"teamorouter","model":"deepseek-v4-flash"},
#   {"name":"pro","provider_ref":"teamorouter","model":"deepseek-v4-pro"}
# ]'
BRAKEFAST_LLM_BASE_URL=https://openrouter.ai/api/v1
BRAKEFAST_LLM_API_KEY=your_api_key_here
BRAKEFAST_LLM_MODEL=openrouter/anthropic/claude-sonnet-4-6

# Optional image fallback provider chain. Source images, article metadata,
# Wikimedia and local editorial assets are always preferred before generators.
# Example:
# BRAKEFAST_IMAGE_PROVIDER_CHAIN='[
#   {"name":"huggingface","provider":"huggingface","api_key_env":"HF_TOKEN","model":"black-forest-labs/FLUX.1-schnell"}
# ]'
