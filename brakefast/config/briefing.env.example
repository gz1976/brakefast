# Copy to brakefast/config/briefing.env or briefing.local.env
# and replace with real values. Without these variables the
# briefing engine falls back to heuristic summaries.
BRAKEFAST_LLM_BASE_URL=https://openrouter.ai/api/v1
BRAKEFAST_LLM_API_KEY=your_api_key_here
BRAKEFAST_LLM_MODEL=openrouter/anthropic/claude-sonnet-4-6
